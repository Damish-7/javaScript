const graph = {
  A: ["B", "C"],
  B: ["D"],
  C: ["E"],
  D: [],
  E: []
};

function dfs(node, visited = new Set()) {
  console.log(node);
  visited.add(node);

  for (let next of graph[node]) {
    if (!visited.has(next)) {
      dfs(next, visited);
    }
  }
}
dfs("A");
console.log("bfs up ////////dfs down");



function bfs(start) {
  let queue = [start];
  let visited = new Set([start]);

  while (queue.length > 0) {
    let node = queue.shift();
    console.log(node);

    for (let next of graph[node]) {
      if (!visited.has(next)) {
        visited.add(next);
        queue.push(next);
      }
    }
  }
}
bfs("A");

