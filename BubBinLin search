let arr = [2, 4, 6, 8, 10, 12];
let target = 10;                                  //linear search

let found = false;

for (let i=0; i< arr.length; i++){
    if(arr[i] === target){
        console.log("element found at index :", i);
        found = true;
        break;
    }
}
if(!found){
    console.log("element not found");
}


